---
import Layout from "../layouts/Layout.astro";
import { SmoothScroll } from "../components/SmoothScroll";
import { CustomCursor } from "../components/CustomCursor";
import { Navbar } from "../components/Navbar";
import { OfficeCard } from "../components/OfficeCard";
import { Contact as ContactForm } from "../components/Contact";
import { Footer } from "../components/Footer";
---

<Layout title="Contact Us | Words4Web">
  <SmoothScroll client:load />
  <CustomCursor client:load />

  <div
    class="relative w-full min-h-screen bg-[var(--background)] text-[var(--text-primary)] selection:bg-[var(--primary)] selection:text-white overflow-hidden">
    <div
      class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-purple-600/5 dark:bg-purple-600/10 blur-[150px] pointer-events-none">
    </div>
    <div
      class="absolute bottom-[20%] right-[-10%] w-[45vw] h-[45vw] rounded-full bg-blue-600/5 dark:bg-blue-600/10 blur-[150px] pointer-events-none">
    </div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(128,128,128,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(128,128,128,0.03)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none z-0">
    </div>

    <Navbar client:load />

    <main
      class="pt-24 pb-12 px-4 max-w-7xl mx-auto flex flex-col gap-10 md:gap-14 relative z-10">
      <div class="text-center max-w-3xl mx-auto flex flex-col gap-4">
        <div
          class="inline-flex items-center justify-center gap-2 self-center px-4 py-1.5 rounded-full border border-purple-500/30 bg-purple-500/5 backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--primary)] opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-2 w-2 bg-[var(--primary)]"
            ></span>
          </span>
          <span
            class="text-xs font-semibold uppercase tracking-widest text-[var(--text-secondary)]">
            Hubs & Operations
          </span>
        </div>
        <h1
          class="text-3xl md:text-5xl font-extralight tracking-tight text-[var(--text-primary)] leading-tight">
          Let's Start a <br class="hidden md:inline" />
          <span
            class="bg-gradient-to-r from-purple-400 via-indigo-400 to-blue-400 bg-clip-text text-transparent font-normal"
            >Conversation</span
          >
        </h1>
        <p
          class="text-base text-[var(--text-secondary)] font-light leading-relaxed max-w-2xl mx-auto">
          We operate across borders to deliver digital excellence. Drop by,
          schedule a call, or fill in the brief.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 w-full">
        <OfficeCard
          client:load
          label="Primary HQ"
          city="Nashik, India"
          address="5037, SSRF, Near City Center Mall, Lavate Nagar, Nashik 422002"
          phone="+91 7020207611"
          email="info@words4web.com"
        />

        <OfficeCard
          client:load
          label="United Kingdom"
          city="London, UK"
          address="56, Morgan drive, Greenhithe, Dartford DA9 9DT, United Kingdom"
          phone="+44 7344861555"
          email="info@words4web.com"
        />
      </div>

      <div class="w-full">
        <ContactForm client:load />
      </div>
    </main>

    <Footer />
  </div>
</Layout>
