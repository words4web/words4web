---
import Layout from "../../layouts/Layout.astro";
import { SmoothScroll } from "../../components/SmoothScroll";
import { CustomCursor } from "../../components/CustomCursor";
import { Navbar } from "../../components/Navbar";
import { Footer } from "../../components/Footer";
import { PortfolioGrid } from "../../components/PortfolioGrid";
---

<Layout title="Our Works | Words4Web">
  <SmoothScroll client:load />
  <CustomCursor client:load />

  <div
    class="relative w-full min-h-screen bg-[var(--background)] text-[var(--text-primary)] selection:bg-[var(--primary)] selection:text-white overflow-x-clip">
    <div
      class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-purple-600/5 dark:bg-purple-600/10 blur-[150px] pointer-events-none">
    </div>
    <div
      class="absolute bottom-[20%] right-[-10%] w-[45vw] h-[45vw] rounded-full bg-blue-600/5 dark:bg-blue-600/10 blur-[150px] pointer-events-none">
    </div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(128,128,128,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(128,128,128,0.03)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none z-0">
    </div>

    <Navbar client:load />

    <main
      class="py-6 px-4 max-w-7xl mx-auto relative z-10 flex flex-col gap-8 md:gap-12 mt-28">
      <div class="text-center max-w-3xl mx-auto flex flex-col gap-3">
        <div
          class="inline-flex items-center justify-center gap-2 self-center px-4 py-1 rounded-full border border-purple-500/30 bg-purple-500/5 backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span
              class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--primary)] opacity-75"
            ></span>
            <span
              class="relative inline-flex rounded-full h-2 w-2 bg-[var(--primary)]"
            ></span>
          </span>
          <span
            class="text-xs font-semibold uppercase tracking-widest text-[var(--text-secondary)]">
            Our Works
          </span>
        </div>
        <h1
          class="text-3xl md:text-5xl font-extralight tracking-tight text-[var(--text-primary)] leading-tight">
          Our <span
            class="bg-gradient-to-r from-purple-400 via-indigo-400 to-blue-400 bg-clip-text text-transparent font-normal"
            >Works</span
          >
        </h1>
        <p
          class="text-sm md:text-base text-[var(--text-secondary)] font-light leading-relaxed max-w-2xl mx-auto">
          Explore our portfolio of completed projects, built solutions, and
          measurable client results.
        </p>
      </div>

      <PortfolioGrid client:load />
    </main>

    <Footer />
  </div>
</Layout>
