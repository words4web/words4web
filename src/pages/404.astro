---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/Navbar";
import { Footer } from "../components/Footer";
import { CustomCursor } from "../components/CustomCursor";
import { ArrowLeft } from "lucide-react";
---

<Layout
  title="404: Page Not Found | Words4Web"
  description="The page you are looking for does not exist or has been moved. Return to the Words4Web homepage.">
  <CustomCursor client:load />
  <Navbar client:load />

  <main
    class="relative min-h-[85vh] flex items-center justify-center overflow-hidden px-4"
    style="padding-top: 200px; padding-bottom: 200px;">
    <div
      class="absolute top-1/2 left-1/4 -translate-y-1/2 w-[300px] sm:w-[500px] h-[300px] sm:h-[500px] bg-[var(--primary)]/10 rounded-full blur-[80px] sm:blur-[120px] pointer-events-none">
    </div>
    <div
      class="absolute top-1/3 right-1/4 -translate-y-1/2 w-[250px] sm:w-[400px] h-[250px] sm:h-[400px] bg-purple-500/10 rounded-full blur-[70px] sm:blur-[100px] pointer-events-none">
    </div>

    <div class="relative z-10 w-full max-w-2xl mx-auto text-center">
      <div class="relative inline-block mb-6 md:mb-10">
        <h1
          class="text-8xl md:text-[10rem] font-display font-extrabold tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-[var(--primary)] to-purple-400 select-none animate-pulse leading-none">
          404
        </h1>
        <div
          class="absolute -inset-2 bg-gradient-to-r from-[var(--primary)] to-purple-500 rounded-2xl opacity-10 blur-xl">
        </div>
      </div>

      <h2
        class="text-2xl sm:text-3xl md:text-5xl font-display font-bold text-[var(--text-primary)] mb-4 md:mb-6 tracking-tight leading-tight px-2">
        Lost in the Digital Space?
      </h2>

      <p
        class="text-sm sm:text-base md:text-xl text-[var(--text-secondary)] mb-8 md:mb-12 max-w-md md:max-w-lg mx-auto leading-relaxed px-4">
        The page you are looking for doesn't exist, was renamed, or has traveled
        to another dimension. Let's get you back on track.
      </p>

      <div
        class="flex flex-col sm:flex-row gap-4 justify-center items-center w-full max-w-sm sm:max-w-none mx-auto px-4">
        <a
          href="/"
          class="w-full sm:w-auto flex items-center justify-center gap-2.5 px-6 sm:px-8 py-3.5 sm:py-4 rounded-full bg-gradient-to-r from-[var(--primary)] to-purple-600 text-white font-semibold shadow-[0_4px_22px_rgba(123,44,191,0.35)] hover:shadow-[0_6px_28px_rgba(123,44,191,0.45)] hover:scale-105 active:scale-98 transition-all duration-300 interactive cursor-pointer">
          <ArrowLeft size={18} />
          <span>Back to Homepage</span>
        </a>
        <a
          href="/#services"
          class="w-full sm:w-auto flex items-center justify-center px-6 sm:px-8 py-3.5 sm:py-4 rounded-full bg-black/[0.04] dark:bg-white/[0.06] border border-black/10 dark:border-white/10 text-[var(--text-primary)] font-semibold hover:bg-black/10 dark:hover:bg-white/10 hover:scale-105 active:scale-98 transition-all duration-300 interactive cursor-pointer">
          Explore Services
        </a>
      </div>
    </div>
  </main>

  <Footer client:load />
</Layout>
