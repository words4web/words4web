---
import Layout from "../layouts/Layout.astro";
import { SmoothScroll } from "../components/SmoothScroll";
import { CustomCursor } from "../components/CustomCursor";
import { Navbar } from "../components/Navbar";
import { Footer } from "../components/Footer";
import { ShieldCheck, Mail, Phone, Clock } from "lucide-react";

const tocItems = [
  { id: "1-info-we-collect", label: "1. Information We Collect" },
  { id: "2-how-we-use", label: "2. How We Use Data" },
  { id: "3-legal-basis", label: "3. Legal Basis" },
  { id: "4-cookies", label: "4. Cookies & Tracking" },
  { id: "5-third-party", label: "5. Third-Party Tools" },
  { id: "6-sharing", label: "6. Sharing Information" },
  { id: "8-retention", label: "8. Data Retention" },
  { id: "9-security", label: "9. Data Security" },
  { id: "10-your-rights", label: "10. Your Rights" },
  { id: "11-external-links", label: "11. External Links" },
  { id: "12-contact-us", label: "12. Get In Touch" },
];
---

<Layout title="Privacy Policy | Words4Web">
  <SmoothScroll client:load />
  <CustomCursor client:load />

  <div
    class="relative w-full min-h-screen bg-[var(--background)] text-[var(--text-primary)] selection:bg-[var(--primary)] selection:text-white overflow-x-clip">
    <!-- Glowing backdrop lights -->
    <div
      class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-purple-600/5 dark:bg-purple-600/10 blur-[150px] pointer-events-none">
    </div>
    <div
      class="absolute bottom-[20%] right-[-10%] w-[45vw] h-[45vw] rounded-full bg-blue-600/5 dark:bg-blue-600/10 blur-[150px] pointer-events-none">
    </div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(128,128,128,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(128,128,128,0.03)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none z-0">
    </div>

    <Navbar client:load />

    <main
      class="pt-32 pb-24 px-4 max-w-7xl mx-auto relative z-10 flex flex-col gap-12 md:gap-16">
      <!-- Title Header Block -->
      <div
        class="text-left max-w-4xl border-b border-black/[0.08] dark:border-white/[0.08] pb-10 flex flex-col gap-5">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-purple-500/30 bg-purple-500/5 backdrop-blur-md w-fit">
          <ShieldCheck size={14} className="text-purple-400" />
          <span
            class="text-xs font-semibold uppercase tracking-widest text-[var(--text-secondary)]">
            Compliance & Transparency
          </span>
        </div>
        <h1
          class="text-4xl md:text-7xl font-extralight tracking-tight text-[var(--text-primary)] leading-tight">
          Privacy <span
            class="bg-gradient-to-r from-purple-400 via-indigo-400 to-blue-400 bg-clip-text text-transparent font-normal"
            >Policy</span
          >
        </h1>
        <div
          class="flex items-center gap-6 text-sm text-[var(--text-secondary)] font-light mt-2">
          <span class="flex items-center gap-1.5"
            ><Clock size={14} /> Last updated: August 2026</span
          >
        </div>
      </div>

      <!-- Content Section (Double Column Grid) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start w-full">
        <!-- Left: Sticky Table of Contents (5/12) -->
        <aside
          class="lg:col-span-4 sticky top-32 hidden lg:flex flex-col gap-6 p-8 rounded-3xl border border-black/[0.08] dark:border-white/[0.08] bg-white/[0.01] dark:bg-white/[0.01] backdrop-blur-xl">
          <h3
            class="font-display font-semibold text-lg uppercase tracking-wider text-[var(--text-primary)]">
            Sections
          </h3>
          <nav class="flex flex-col gap-3 text-left">
            {
              tocItems.map((item) => (
                <a
                  href={`#${item.id}`}
                  class="text-sm text-[var(--text-secondary)] hover:text-[var(--primary)] hover:translate-x-1 transition-all duration-300 font-light">
                  {item.label}
                </a>
              ))
            }
          </nav>
        </aside>

        <!-- Right: Text Content Block (8/12) -->
        <div
          class="lg:col-span-8 flex flex-col gap-10 text-left text-base md:text-lg text-[var(--text-secondary)] font-light leading-relaxed">
          <p
            class="text-xl font-light text-[var(--text-primary)] leading-relaxed border-l-2 border-[var(--primary)] pl-6 py-2">
            At Words4Web, we are committed to protecting your privacy and
            handling your personal data responsibly. This Privacy Policy
            explains how we collect, use, and protect your information when you
            visit our website.
          </p>

          <section
            id="1-info-we-collect"
            class="flex flex-col gap-4 border-t border-black/[0.08] dark:border-white/[0.06] pt-8 scroll-mt-32">
            <h2 class="text-2xl font-normal text-[var(--text-primary)]">
              1. Information We Collect
            </h2>
            <p>We may collect the following types of personal data:</p>
            <div
              class="pl-4 border-l border-black/[0.08] dark:border-white/[0.08] flex flex-col gap-4 mt-2">
              <div>
                <h3 class="font-normal text-[var(--text-primary)]">
                  a. Information You Provide
                </h3>
                <p class="mt-1">
                  When you fill out forms, contact us, or request services, we
                  may collect:
                </p>
                <ul class="list-disc pl-6 mt-2 flex flex-col gap-1 text-base">
                  <li>Full name</li>
                  <li>Email address</li>
                  <li>Phone number</li>
                  <li>Company name</li>
                  <li>Project or service requirements</li>
                </ul>
              </div>
              <div>
                <h3 class="font-normal text-[var(--text-primary)]">
                  b. Automatically Collected Information
                </h3>
                <p class="mt-1">When you visit our website, we may collect:</p>
                <ul class="list-disc pl-6 mt-2 flex flex-col gap-1 text-base">
                  <li>IP address</li>
                  <li>Browser type and version</li>
                  <li>Pages visited and time spent</li>
                  <li>Device and location data</li>
                </ul>
              </div>
            </div>
          </section>

          <section
            id="2-how-we-use"
            class="flex flex-col gap-3 border-t border-black/[0.08] dark:border-white/[0.06] pt-8 scroll-mt-32">
            <h2 class="text-2xl font-normal text-[var(--text-primary)]">
              2. How We Use Your Information
            </h2>
            <p>We use your data to:</p>
            <ul class="list-disc pl-6 flex flex-col gap-2 text-base">
              <li>Respond to your enquiries and provide quotes</li>
              <li>Deliver digital marketing services</li>
              <li>Improve our website performance and user experience</li>
              <li>
                Send updates, newsletters, or promotional content (only with
                your consent)
              </li>
              <li>Analyse website traffic and marketing performance</li>
            </ul>
          </section>

          <section
            id="3-legal-basis"
            class="flex flex-col gap-3 border-t border-black/[0.08] dark:border-white/[0.06] pt-8 scroll-mt-32">
            <h2 class="text-2xl font-normal text-[var(--text-primary)]">
              3. Legal Basis for Processing
            </h2>
            <p>We process your data based on:</p>
            <ul class="list-disc pl-6 flex flex-col gap-2 text-base">
              <li>
                <strong class="text-[var(--text-primary)] font-medium"
                  >Consent</strong
                > – When you submit a form or subscribe
              </li>
              <li>
                <strong class="text-[var(--text-primary)] font-medium"
                  >Legitimate Interest</strong
                > – To improve services and respond to enquiries
              </li>
              <li>
                <strong class="text-[var(--text-primary)] font-medium"
                  >Contractual Need</strong
                > – When providing agreed services
              </li>
              <li>
                <strong class="text-[var(--text-primary)] font-medium"
                  >Legal Obligations</strong
                > – Where required by law
              </li>
            </ul>
          </section>

          <section
            id="4-cookies"
            class="flex flex-col gap-3 border-t border-black/[0.08] dark:border-white/[0.06] pt-8 scroll-mt-32">
            <h2 class="text-2xl font-normal text-[var(--text-primary)]">
              4. Cookies & Tracking Technologies
            </h2>
            <p>
              We use cookies and similar tracking tools to improve your browsing
              experience. These may include:
            </p>
            <ul class="list-disc pl-6 flex flex-col gap-2 text-base">
              <li>Website functionality cookies</li>
              <li>Analytics tools (e.g., Google Analytics)</li>
              <li>Advertising tools (e.g., Google Ads, Meta Ads)</li>
            </ul>
            <p class="mt-2 text-base">
              You can control or disable cookies through your browser settings.
            </p>
          </section>

          <section
            id="5-third-party"
            class="flex flex-col gap-3 border-t border-black/[0.08] dark:border-white/[0.06] pt-8 scroll-mt-32">
            <h2 class="text-2xl font-normal text-[var(--text-primary)]">
              5. Third-Party Services
            </h2>
            <p>
              We may use trusted third-party tools to operate our business, such
              as:
            </p>
            <ul class="list-disc pl-6 flex flex-col gap-2 text-base">
              <li>Analytics platforms</li>
              <li>Advertising platforms</li>
              <li>CRM and email marketing tools</li>
            </ul>
            <p class="mt-2 text-base">
              These providers may process your data on our behalf and are
              required to keep it secure.
            </p>
          </section>

          <section
            id="6-sharing"
            class="flex flex-col gap-3 border-t border-black/[0.08] dark:border-white/[0.06] pt-8 scroll-mt-32">
            <h2 class="text-2xl font-normal text-[var(--text-primary)]">
              6. Sharing Your Information
            </h2>
            <p>We do not sell your personal data.</p>
            <p>We may share your information:</p>
            <ul class="list-disc pl-6 flex flex-col gap-2 text-base">
              <li>With trusted service providers</li>
              <li>To comply with legal obligations</li>
              <li>To protect our rights and prevent fraud</li>
            </ul>
          </section>

          <section
            id="8-retention"
            class="flex flex-col gap-3 border-t border-black/[0.08] dark:border-white/[0.06] pt-8 scroll-mt-32">
            <h2 class="text-2xl font-normal text-[var(--text-primary)]">
              8. Data Retention
            </h2>
            <p>We retain your data only as long as necessary to:</p>
            <ul class="list-disc pl-6 flex flex-col gap-2 text-base">
              <li>Fulfil the purpose it was collected for</li>
              <li>Meet legal and regulatory requirements</li>
            </ul>
          </section>

          <section
            id="9-security"
            class="flex flex-col gap-3 border-t border-black/[0.08] dark:border-white/[0.06] pt-8 scroll-mt-32">
            <h2 class="text-2xl font-normal text-[var(--text-primary)]">
              9. Data Security
            </h2>
            <p>
              We take appropriate measures to protect your personal data,
              including:
            </p>
            <ul class="list-disc pl-6 flex flex-col gap-2 text-base">
              <li>Secure hosting systems</li>
              <li>Access control and data protection protocols</li>
              <li>Regular monitoring of systems</li>
            </ul>
          </section>

          <section
            id="10-your-rights"
            class="flex flex-col gap-3 border-t border-black/[0.08] dark:border-white/[0.06] pt-8 scroll-mt-32">
            <h2 class="text-2xl font-normal text-[var(--text-primary)]">
              10. Your Rights
            </h2>
            <p>Depending on your location, you may have the right to:</p>
            <ul class="list-disc pl-6 flex flex-col gap-2 text-base">
              <li>Access your personal data</li>
              <li>Request correction or deletion</li>
              <li>Restrict or object to processing</li>
              <li>Withdraw consent at any time</li>
            </ul>
            <p class="mt-2 text-base font-light">
              To exercise your rights, please contact us.
            </p>
          </section>

          <section
            id="11-external-links"
            class="flex flex-col gap-3 border-t border-black/[0.08] dark:border-white/[0.06] pt-8 scroll-mt-32">
            <h2 class="text-2xl font-normal text-[var(--text-primary)]">
              11. Third-Party Links
            </h2>
            <p>
              Our website may contain links to external websites. We are not
              responsible for their privacy practices.
            </p>
          </section>

          <section
            id="12-contact-us"
            class="group relative p-[1px] rounded-3xl overflow-hidden mt-8 transition-all duration-500 w-full scroll-mt-32">
            <!-- Glowing Line Tracing Card Border -->
            <div
              class="absolute inset-0 rounded-3xl overflow-hidden pointer-events-none z-0">
              <div
                class="absolute top-1/2 left-1/2 w-[300%] h-[300%] animate-border-trace"
                style={{
                  background:
                    "conic-gradient(from 0deg, transparent 0deg, transparent 320deg, var(--primary) 340deg, #9d4edd 350deg, #c084fc 360deg)",
                }}>
              </div>
            </div>

            <div
              class="relative z-10 p-8 rounded-[23px] bg-[var(--background)] dark:bg-[#0c0c0e] flex flex-col gap-4 border border-black/[0.03] dark:border-white/[0.02] shadow-[0_8px_30px_rgba(123,44,191,0.04)] dark:shadow-[inset_0_0_30px_rgba(123,44,191,0.1)]">
              <h2 class="text-2xl font-normal text-[var(--text-primary)]">
                12. Contact Us
              </h2>
              <p class="text-base font-light">
                If you have any questions about this Privacy Policy, please
                contact us:
              </p>

              <div
                class="mt-4 flex flex-col gap-3 text-base font-normal border-t border-black/[0.08] dark:border-white/[0.06] pt-4">
                <p class="text-[var(--text-primary)] font-medium text-lg">
                  Words4Web
                </p>

                <div class="flex items-center gap-3">
                  <Mail size={16} className="text-purple-400 shrink-0" />
                  <a
                    href="mailto:info@words4web.com"
                    class="text-[#a855f7] hover:text-[#c084fc] hover:underline transition-colors font-light"
                    >info@words4web.com</a
                  >
                </div>

                <div
                  class="flex items-start md:items-center flex-col md:flex-row gap-3 md:gap-4">
                  <div class="flex items-center gap-3">
                    <Phone size={16} className="text-purple-400 shrink-0" />
                    <a
                      href="tel:+917020207611"
                      class="text-[#a855f7] hover:text-[#c084fc] hover:underline transition-colors font-light"
                      >+91 7020207611</a
                    >
                  </div>
                  <span class="hidden md:inline text-white/20">|</span>
                  <div class="flex items-center gap-3">
                    <Phone
                      size={16}
                      className="text-purple-400 shrink-0 animate-pulse"
                    />
                    <a
                      href="tel:+447344861555"
                      class="text-[#a855f7] hover:text-[#c084fc] hover:underline transition-colors font-light"
                      >+44 7344861555</a
                    >
                  </div>
                </div>
              </div>
            </div>
          </section>
        </div>
      </div>
    </main>

    <Footer />
  </div>
</Layout>
