---
import Layout from '../../layouts/Layout.astro';
import { SmoothScroll } from '../../components/SmoothScroll';
import { CustomCursor } from '../../components/CustomCursor';
import { Navbar } from '../../components/Navbar';
import { Footer } from '../../components/Footer';
import { caseStudiesData } from '../../data/caseStudiesData';

---

<Layout title="Case Studies | Words4Web">
  <SmoothScroll client:load />
  <CustomCursor client:load />
  
  <div class="relative w-full min-h-screen bg-[var(--background)] text-[var(--text-primary)] selection:bg-[var(--primary)] selection:text-white overflow-x-clip">
    <div class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-purple-600/5 dark:bg-purple-600/10 blur-[150px] pointer-events-none" />
    <div class="absolute bottom-[20%] right-[-10%] w-[45vw] h-[45vw] rounded-full bg-blue-600/5 dark:bg-blue-600/10 blur-[150px] pointer-events-none" />
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(128,128,128,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(128,128,128,0.03)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none z-0" />

    <Navbar client:load />
    
    <div class="pt-32 px-4 max-w-7xl mx-auto relative z-10 text-left text-sm text-[var(--text-secondary)] font-mono">
      <a href="/" class="hover:text-[var(--primary)]">Home</a>
      <span class="mx-2">&gt;</span>
      <span class="text-[var(--text-primary)] font-medium">Case Studies</span>
    </div>

    <main class="py-12 px-4 max-w-7xl mx-auto relative z-10 flex flex-col gap-16 md:gap-24">
      <div class="text-center max-w-3xl mx-auto flex flex-col gap-6">
        <div class="inline-flex items-center justify-center gap-2 self-center px-4 py-1.5 rounded-full border border-purple-500/30 bg-purple-500/5 backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--primary)] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--primary)]"></span>
          </span>
          <span class="text-xs font-semibold uppercase tracking-widest text-[var(--text-secondary)]">
            Detailed Showcases
          </span>
        </div>
        <h1 class="text-4xl md:text-6xl font-extralight tracking-tight text-[var(--text-primary)] leading-tight">
          Our Deep Dive <br class="hidden md:inline" />
          <span class="bg-gradient-to-r from-purple-400 via-indigo-400 to-blue-400 bg-clip-text text-transparent font-normal">Case Studies</span>
        </h1>
        <p class="text-base text-[var(--text-secondary)] font-light leading-relaxed max-w-2xl mx-auto">
          Explore complete analysis documents outlining requirements, implemented solutions, and measurable outcomes for our main project initiatives.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 max-w-[1200px] mx-auto w-full">
        {caseStudiesData.map((study) => (
          <div class="group relative w-full max-w-[560px] aspect-video mx-auto rounded-3xl overflow-hidden glass-panel border border-black/[0.08] dark:border-white/[0.08] bg-[var(--background-secondary)] shadow-lg hover:shadow-2xl hover:border-purple-500/30 transition-all duration-500 select-none">
            
            <!-- Tech stack mini badges in top right -->
            <div class="absolute top-4 right-4 z-20 flex gap-1.5">
              {study.technologies.map((tech) => (
                <div class="w-8 h-8 rounded-full bg-[#0c0a14] border border-white/10 flex items-center justify-center p-1.5 shadow-lg transition-all duration-300" title={tech.name}>
                  <img src={tech.iconUrl || `https://cdn.simpleicons.org/${tech.name.toLowerCase()}`} alt={tech.name} class="w-5 h-5 object-contain" style="filter: brightness(1.3) contrast(1.2);" />
                </div>
              ))}
            </div>

            <div class="absolute inset-0 overflow-hidden bg-black/10 z-0">
              <img
                src={study.image}
                alt={study.title}
                class="w-full h-full object-cover object-top select-none group-hover:scale-105 transition-transform duration-700"
              />
            </div>

            <div class="absolute bottom-0 left-0 right-0 h-[80%] z-10 transform translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out flex flex-col justify-end text-left" style="background: linear-gradient(to top, rgba(5,2,15,0.98) 40%, rgba(5,2,15,0.75) 70%, transparent 100%);">
              <div class="px-5 pb-5 flex flex-col gap-3">
                <span class="text-purple-400 text-[10px] font-bold uppercase tracking-[0.18em]">
                  {study.services}
                </span>
                <h3 class="text-lg font-semibold text-white leading-snug">
                  {study.title}
                </h3>
                <p class="text-[11px] text-white/55 leading-relaxed line-clamp-2">
                  {study.description}
                </p>
                <a href={study.link} class="mt-1 self-start inline-flex items-center gap-2 px-4 py-2 rounded-full border border-white/15 bg-white/5 hover:bg-purple-600 hover:border-purple-600 text-white text-[11px] font-semibold tracking-wide transition-all duration-300 backdrop-blur-sm">
                  Read Case Study <span class="text-sm">→</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </main>
    
    <Footer />
  </div>
</Layout>
