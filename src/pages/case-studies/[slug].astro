---
import Layout from "../../layouts/Layout.astro";
import { SmoothScroll } from "../../components/SmoothScroll";
import { CustomCursor } from "../../components/CustomCursor";
import { Navbar } from "../../components/Navbar";
import { Footer } from "../../components/Footer";
import { caseStudiesData } from "../../data/caseStudiesData";
import { Globe, Layers, CheckCircle } from "lucide-react";
import { MagneticButton } from "../../components/MagneticButton";
import { Contact } from "../../components/Contact";

export async function getStaticPaths() {
  return caseStudiesData.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;
---

<Layout title={`${study.title} Case Study | Words4Web`}>
  <SmoothScroll client:load />
  <CustomCursor client:load />

  <div
    class="relative w-full min-h-screen bg-[var(--background)] text-[var(--text-primary)] selection:bg-[var(--primary)] selection:text-white overflow-x-clip">
    <div
      class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-purple-600/5 dark:bg-purple-600/10 blur-[150px] pointer-events-none">
    </div>
    <div
      class="absolute bottom-[20%] right-[-10%] w-[45vw] h-[45vw] rounded-full bg-blue-600/5 dark:bg-blue-600/10 blur-[150px] pointer-events-none">
    </div>
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(128,128,128,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(128,128,128,0.03)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none z-0">
    </div>

    <Navbar client:load />

    <div
      class="pt-32 px-4 max-w-7xl mx-auto relative z-10 text-left text-sm text-[var(--text-secondary)] font-mono">
      <a href="/" class="hover:text-[var(--primary)]">Home</a>
      <span class="mx-2">&gt;</span>
      <a href="/case-studies" class="hover:text-[var(--primary)]"
        >Case Studies</a
      >
      <span class="mx-2">&gt;</span>
      <span class="text-[var(--text-primary)] font-medium">{study.title}</span>
    </div>

    <main
      class="py-12 px-4 max-w-7xl mx-auto flex flex-col gap-12 md:gap-24 relative z-10">
      <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 flex flex-col gap-8 text-left">
          <div class="flex flex-col gap-4">
            <h1
              class="text-4xl md:text-6xl font-extralight tracking-tight text-[var(--text-primary)] leading-tight">
              About <span
                class="bg-gradient-to-r from-purple-400 via-indigo-400 to-blue-400 bg-clip-text text-transparent font-normal"
                >{study.title}</span
              >
            </h1>
            <p
              class="text-lg text-[var(--text-secondary)] font-light leading-relaxed">
              {study.aboutText1}
            </p>
            <p
              class="text-lg text-[var(--text-secondary)] font-light leading-relaxed">
              {study.aboutText2}
            </p>
          </div>

          <div class="flex flex-col gap-3">
            <h4
              class="text-sm font-bold uppercase tracking-wider text-[var(--text-secondary)]">
              Partners Used
            </h4>
            <div class="flex flex-wrap gap-4">
              {
                study.partners.map((partner) => (
                  <div class="px-5 py-3 rounded-2xl border border-black/[0.08] dark:border-white/[0.08] bg-white/[0.02] dark:bg-white/[0.01] backdrop-blur-md flex items-center gap-2">
                    <span class="font-bold">{partner.name}</span>
                    {partner.badge && (
                      <span class="text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">
                        {partner.badge}
                      </span>
                    )}
                  </div>
                ))
              }
            </div>
          </div>
        </div>

        <div class="lg:col-span-6 flex flex-col items-center gap-8">
          <div class="w-full relative group">
            <div
              class="relative w-full rounded-2xl border-4 border-[#333] bg-[#222] shadow-2xl overflow-hidden aspect-[4/3] max-w-[560px] mx-auto">
              <div class="absolute inset-0 bg-black/10 z-0"></div>
              <img
                src={study.image}
                alt={`${study.title} mockup`}
                class="w-full h-full object-contain relative z-10 transition-all duration-[6s] ease-in-out"
              />
            </div>
            <div
              class="w-24 h-12 bg-[#333] dark:bg-[#444] mx-auto shadow-md rounded-b-xl relative z-0">
            </div>
            <div
              class="w-48 h-2 bg-[#222] dark:bg-[#333] mx-auto rounded-full shadow-lg relative z-0">
            </div>
          </div>

          <a href="/#contact">
            <MagneticButton
              client:load
              variant="primary"
              className="px-8 py-3.5 text-sm font-bold flex items-center gap-2.5">
              <span>Collaborate With Us</span>
              <span>→</span>
            </MagneticButton>
          </a>
        </div>
      </section>

      <section
        class="flex flex-col gap-12 border-t border-black/[0.08] dark:border-white/[0.08] pt-10 md:pt-16 text-center max-w-5xl mx-auto w-full">
        <div class="flex flex-col gap-4 max-w-3xl mx-auto">
          <h2
            class="text-2xl md:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
            Technologies Used
          </h2>
          <p
            class="text-base text-[var(--text-secondary)] font-light leading-relaxed">
            We integrated a combination of design tools and communication
            channels to deliver robust digital outreach.
          </p>
        </div>

        <div
          class="grid grid-cols-2 md:grid-cols-5 gap-6 justify-center items-center">
          {
            study.technologies.map((tech) => (
              <div class="p-6 rounded-3xl border border-black/[0.05] dark:border-white/[0.05] bg-white/[0.01] dark:bg-white/[0.01] flex flex-col gap-2 items-center hover:border-purple-500/20 transition-all duration-300">
                <div class="w-16 h-16 flex items-center justify-center mb-2">
                  <img
                    src={
                      tech.iconUrl ||
                      `https://cdn.simpleicons.org/${tech.name.toLowerCase()}`
                    }
                    alt={tech.name}
                    class="w-12 h-12 object-contain opacity-95 group-hover:opacity-100 transition-all duration-300"
                    style="filter: contrast(1.3) brightness(1.3);"
                    loading="lazy"
                  />
                </div>
                <span class="text-base font-bold text-[var(--text-primary)]">
                  {tech.name}
                </span>
                <span class="text-[10px] uppercase font-bold tracking-widest text-[var(--text-secondary)]">
                  {tech.desc}
                </span>
              </div>
            ))
          }
        </div>
      </section>

      <section
        class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center border-t border-black/[0.08] dark:border-white/[0.08] pt-10 md:pt-16">
        <div
          class="lg:col-span-5 flex justify-center items-center relative py-12 px-4 w-full">
          <div
            class="relative w-full max-w-[280px] aspect-[3/4] rounded-3xl border-[6px] border-[#333] bg-[#111] overflow-hidden shadow-2xl z-10 shrink-0 transform md:-rotate-3 md:hover:rotate-0 rotate-0 transition-transform duration-500">
            <img
              src={study.image}
              class="w-full h-full object-cover object-center"
            />
          </div>
          <div
            class="absolute w-full max-w-[240px] aspect-[3/4] rounded-3xl border-[6px] border-[#222] bg-[#111] overflow-hidden shadow-xl z-0 right-10 top-6 opacity-60 transform rotate-6 hidden sm:block">
            <img
              src={study.image}
              class="w-full h-full object-cover object-top"
            />
          </div>
        </div>

        <div class="lg:col-span-7 flex flex-col gap-8 text-left">
          <div class="flex flex-col gap-4">
            <h2
              class="text-2xl md:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
              Services we offered
            </h2>
            <p class="text-base text-[var(--text-secondary)] font-light">
              Here are Core Services we provided to meet the vision and
              compliance standards of the project:
            </p>
          </div>

          <div class="flex flex-col gap-6">
            {
              study.servicesOffered.map((service) => (
                <div class="flex gap-4">
                  <span class="text-[var(--primary)] text-lg mt-0.5">•</span>
                  <div>
                    <h3 class="text-lg font-semibold text-[var(--text-primary)]">
                      {service.title}
                    </h3>
                    <p class="text-sm text-[var(--text-secondary)] font-light mt-1">
                      {service.desc}
                    </p>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>

      <section
        class="w-full p-[2px] rounded-3xl bg-gradient-to-r from-purple-500 via-indigo-500 to-blue-500 shadow-2xl relative overflow-hidden group">
        <div
          class="p-8 md:p-12 rounded-[22px] bg-[#0c051a] flex flex-col md:flex-row justify-between items-center gap-8 relative z-10 text-center md:text-left">
          <div class="flex flex-col gap-2">
            <h2
              class="text-2xl md:text-4xl font-extralight tracking-tight text-white">
              Got a project you'd like to <span
                class="text-purple-400 font-normal">discuss?</span
              >
            </h2>
            <p class="text-sm text-purple-200/70 font-light">
              Let's build something innovative, inclusive, and sustainable
              together.
            </p>
          </div>
          <a href="/#contact" class="shrink-0">
            <MagneticButton
              client:load
              className="px-8 py-3.5 border border-purple-500 bg-purple-500/10 hover:bg-purple-500 text-white font-bold text-xs tracking-wider uppercase">
              Let's Discuss
            </MagneticButton>
          </a>
        </div>
      </section>

      <section
        class="flex flex-col gap-12 border-t border-black/[0.08] dark:border-white/[0.08] pt-10 md:pt-16">
        <div class="text-center max-w-3xl mx-auto flex flex-col gap-4">
          <h2
            class="text-2xl md:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
            Technical Integration
          </h2>
          <p class="text-base text-[var(--text-secondary)] font-light">
            Words4Web provides full stack digital design, assets compliance
            management, and communication architecture.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            study.integrations.map((item, idx) => (
              <div class="relative p-[3px] rounded-3xl overflow-hidden group hover:-translate-y-1 transition-transform duration-500 select-none">
                <div class="absolute inset-0 rounded-3xl overflow-hidden pointer-events-none">
                  <div
                    class="absolute top-1/2 left-1/2 w-[300%] h-[300%] animate-border-trace"
                    style="background: conic-gradient(from 0deg, transparent 0deg, transparent 320deg, var(--trace-color-1) 340deg, var(--trace-color-2) 350deg, var(--trace-color-3) 360deg);"
                  />
                </div>

                <div class="relative p-8 rounded-[21px] border border-black/[0.03] dark:border-white/[0.02] bg-[#f7f7f7] dark:bg-[#0c0c0e] flex flex-col gap-6 text-left h-full z-10 shadow-[0_8px_32px_rgba(0,0,0,0.02)] dark:shadow-[inset_0_0_30px_rgba(0,0,0,0.5)]">
                  <div class="flex flex-col gap-2 relative z-10">
                    <h3 class="text-lg font-bold text-[var(--text-primary)] group-hover:text-[var(--primary)] transition-colors duration-300">
                      {item.title}
                    </h3>
                    <p class="text-sm text-[var(--text-secondary)] font-light leading-relaxed">
                      {item.desc}
                    </p>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section
        class="flex flex-col gap-12 border-t border-black/[0.08] dark:border-white/[0.08] pt-10 md:pt-16">
        <div class="text-center max-w-3xl mx-auto flex flex-col gap-4">
          <h2
            class="text-2xl md:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
            Our Process
          </h2>
          <h2 class="text-2xl font-normal text-[var(--text-primary)]">
            Collaborative Design Methodology
          </h2>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-3 gap-8 w-full max-w-6xl mx-auto text-center items-stretch">
          {
            study.processSteps.map((step) => {
              return (
                <div class="p-8 rounded-3xl border border-black/[0.05] dark:border-white/[0.05] bg-white/[0.01] dark:bg-white/[0.01] flex flex-col gap-4 items-center">
                  <div class="p-3 rounded-full bg-purple-500/10 text-[var(--primary)]">
                    {step.iconName === "Layers" && <Layers size={24} />}
                    {step.iconName === "Globe" && <Globe size={24} />}
                    {step.iconName === "CheckCircle" && (
                      <CheckCircle size={24} />
                    )}
                  </div>
                  <h3 class="text-xl font-semibold text-[var(--text-primary)]">
                    {step.title}
                  </h3>
                  <p class="text-sm text-[var(--text-secondary)] font-light leading-relaxed">
                    {step.desc}
                  </p>
                </div>
              );
            })
          }
        </div>
      </section>
    </main>

    <Contact client:load />

    <Footer />
  </div>
</Layout>
