---
import Layout from "../../layouts/Layout.astro";
import { SmoothScroll } from "../../components/SmoothScroll";
import { CustomCursor } from "../../components/CustomCursor";
import { Navbar } from "../../components/Navbar";
import { Footer } from "../../components/Footer";
import { Contact } from "../../components/Contact";
import { MagneticButton } from "../../components/MagneticButton";
import { servicesData } from "../../data/services/servicesData";

export async function getStaticPaths() {
  return servicesData
    ?.filter((s) => s.slug)
    ?.map((service) => ({
      params: { slug: service.slug },
      props: { service },
    }));
}

const { service } = Astro.props;

const pageTitle = `${service.title} | Words4Web`;
const pageDescription = service.description;
---

<Layout title={pageTitle} description={pageDescription} image={service.image}>
  <SmoothScroll client:load />
  <CustomCursor client:load />

  <div
    class="relative w-full min-h-screen bg-[var(--background)] text-[var(--text-primary)] selection:bg-[var(--primary)] selection:text-white overflow-x-clip">
    <!-- Ambient blobs -->
    <div
      class="absolute top-[-10%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-purple-600/5 dark:bg-purple-600/10 blur-[150px] pointer-events-none">
    </div>
    <div
      class="absolute bottom-[20%] right-[-10%] w-[45vw] h-[45vw] rounded-full bg-blue-600/5 dark:bg-blue-600/10 blur-[150px] pointer-events-none">
    </div>
    <!-- Grid pattern -->
    <div
      class="absolute inset-0 bg-[linear-gradient(to_right,rgba(128,128,128,0.03)_1px,transparent_1px),linear-gradient(to_bottom,rgba(128,128,128,0.03)_1px,transparent_1px)] bg-[size:40px_40px] pointer-events-none z-0">
    </div>

    <Navbar client:load />

    <!-- Breadcrumb -->
    <div
      class="pt-24 md:pt-32 px-4 max-w-7xl mx-auto relative z-10 text-left text-xs md:text-sm text-[var(--text-secondary)] font-mono">
      <a href="/" class="hover:text-[var(--primary)]">Home</a>
      <span class="mx-1.5 md:mx-2">&gt;</span>
      <a href="/#services" class="hover:text-[var(--primary)]">Services</a>
      <span class="mx-1.5 md:mx-2">&gt;</span>
      <span class="text-[var(--text-primary)] font-medium truncate max-w-[140px] sm:max-w-none inline-block align-bottom">{service.title}</span>
    </div>

    <main
      class="py-10 md:py-12 px-4 max-w-7xl mx-auto flex flex-col gap-12 md:gap-24 relative z-10">

      <!-- ═══════════════════════════════════════════════
           HERO: Image top on mobile / side-by-side on lg
      ════════════════════════════════════════════════ -->
      <section class="flex flex-col lg:grid lg:grid-cols-2 gap-8 md:gap-10 lg:gap-16 items-center">
        <!-- Hero Image — always first visually on mobile -->
        <div
          class="relative w-full rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl aspect-square lg:order-1 bg-black/[0.02] dark:bg-white/[0.02]">
          <img
            src={service.image}
            alt={service.title}
            class="w-full h-full object-cover"
            loading="eager"
          />
          <!-- Gradient overlay -->
          <div
            class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent">
          </div>
          {
            service.badge && (
              <div class="absolute top-3 right-3 md:top-5 md:right-5 px-2.5 md:px-4 py-1 md:py-1.5 rounded-full bg-purple-600/80 backdrop-blur-sm text-white text-[10px] md:text-xs font-bold uppercase tracking-wider">
                {service.badge}
              </div>
            )
          }
        </div>

        <!-- Hero Text -->
        <div class="flex flex-col gap-5 md:gap-7 text-left lg:order-2">
          <div
            class="inline-flex w-fit items-center gap-2 px-3 md:px-4 py-1.5 md:py-2 rounded-full border border-purple-500/30 bg-purple-500/5 text-purple-400 text-[10px] md:text-xs font-bold uppercase tracking-widest">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-pulse"></span>
            Words4Web Service
          </div>

          <h1
            class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extralight tracking-tight text-[var(--text-primary)] leading-tight">
            {service.title.split(" ").slice(0, -1).join(" ")}{" "}
            <span
              class="bg-gradient-to-r from-purple-400 via-indigo-400 to-blue-400 bg-clip-text text-transparent font-normal">
              {service.title.split(" ").slice(-1)[0]}
            </span>
          </h1>

          {
            service.heroTagline && (
              <p class="text-base md:text-lg text-[var(--text-secondary)] font-light leading-relaxed">
                {service.heroTagline}
              </p>
            )
          }

          <p
            class="text-sm md:text-base text-[var(--text-secondary)] font-light leading-relaxed">
            {service.description}
          </p>

          <div class="flex flex-col sm:flex-row flex-wrap gap-3 md:gap-4">
            <a href="/#contact" class="w-full sm:w-auto">
              <MagneticButton
                client:load
                variant="primary"
                className="w-full sm:w-auto px-6 md:px-8 py-3 md:py-3.5 text-sm font-bold flex items-center justify-center gap-2.5">
                <span>Get Started</span>
                <span>→</span>
              </MagneticButton>
            </a>
            <a href="/#services" class="w-full sm:w-auto">
              <MagneticButton
                client:load
                className="w-full sm:w-auto px-6 md:px-8 py-3 md:py-3.5 text-sm font-bold border border-[var(--text-secondary)]/20 flex items-center justify-center gap-2.5">
                <span>View All Services</span>
              </MagneticButton>
            </a>
          </div>
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════
           CONTENT SECTIONS (from services.md)
      ════════════════════════════════════════════════ -->
      {
        service.sections && service.sections.length > 0 && (
          <section class="flex flex-col gap-10 md:gap-14 border-t border-black/[0.08] dark:border-white/[0.08] pt-10 md:pt-20">
            <div class="text-center max-w-3xl mx-auto flex flex-col gap-2 md:gap-3">
              <h2 class="text-xl md:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
                Everything We Offer in {service.title}
              </h2>
              <p class="text-sm md:text-base text-[var(--text-secondary)] font-light">
                Here's a detailed breakdown of how we approach and deliver results.
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-8 max-w-6xl mx-auto w-full">
              {service.sections.map((section, idx) => (
                <div class="group relative p-5 sm:p-7 md:p-8 rounded-2xl md:rounded-[24px] border border-black/[0.06] dark:border-white/[0.06] bg-black/[0.01] dark:bg-white/[0.01] hover:bg-black/[0.03] dark:hover:bg-white/[0.02] hover:border-purple-500/30 hover:shadow-[0_12px_40px_rgba(123,44,191,0.08)] hover:-translate-y-1 transition-all duration-300 flex flex-col gap-4 md:gap-5 overflow-hidden">
                  {/* Top glow */}
                  <div class="absolute -right-8 -top-8 w-32 h-32 bg-gradient-to-tr from-purple-500/15 to-blue-500/5 blur-2xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none" />

                  {/* Index Badge */}
                  <div class="w-9 h-9 md:w-10 md:h-10 rounded-xl bg-purple-500/10 dark:bg-purple-500/15 flex items-center justify-center text-[var(--primary)] font-bold text-sm border border-purple-500/20 group-hover:scale-105 transition-transform duration-300 shrink-0">
                    {String(idx + 1).padStart(2, "0")}
                  </div>

                  {/* Heading */}
                  <h3 class="text-base md:text-xl font-bold tracking-tight text-[var(--text-primary)] group-hover:text-[var(--primary)] transition-colors duration-300">
                    {section.heading}
                  </h3>

                  {/* Body */}
                  {section.body && (
                    <p class="text-xs md:text-sm text-[var(--text-secondary)] font-light leading-relaxed">
                      {section.body}
                    </p>
                  )}

                  {/* Items list */}
                  {section.items && section.items.length > 0 && (
                    <ul class="flex flex-col gap-2 md:gap-2.5 relative z-10">
                      {section.items.map((item) => (
                        <li class="flex items-start gap-2.5 md:gap-3 text-xs md:text-sm text-[var(--text-secondary)] leading-relaxed">
                          <span class="mt-1 w-3.5 h-3.5 md:w-4 md:h-4 rounded-full bg-purple-500/15 border border-purple-500/30 flex items-center justify-center shrink-0">
                            <span class="w-1 h-1 md:w-1.5 md:h-1.5 rounded-full bg-purple-400" />
                          </span>
                          {item}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              ))}
            </div>
          </section>
        )
      }

      <!-- ═══════════════════════════════════════════════
           RELATED SERVICES
      ════════════════════════════════════════════════ -->
      <section
        class="border-t border-black/[0.08] dark:border-white/[0.08] pt-10 md:pt-20 flex flex-col gap-6 md:gap-10">
        <div class="text-center max-w-3xl mx-auto flex flex-col gap-2 md:gap-3">
          <h2
            class="text-xl md:text-3xl font-bold tracking-tight text-[var(--text-primary)]">
            Explore More Services
          </h2>
          <p class="text-sm md:text-base text-[var(--text-secondary)] font-light">
            Words4Web covers the full digital spectrum — discover what else we can do for you.
          </p>
        </div>

        <div
          class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5 max-w-6xl mx-auto w-full">
          {
            servicesData
              .filter((s) => s.slug !== service.slug)
              .slice(0, 4)
              .map((related) => (
                <a
                  href={`/services/${related.slug}`}
                  class="group relative rounded-xl md:rounded-2xl overflow-hidden border border-black/[0.07] dark:border-white/[0.07] hover:border-purple-500/30 hover:-translate-y-1 hover:shadow-[0_10px_40px_rgba(123,44,191,0.1)] transition-all duration-300 flex flex-col">
                  <div class="relative aspect-[4/3] overflow-hidden">
                    <img
                      src={related.image}
                      alt={related.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent" />
                  </div>
                  <div class="p-3 md:p-5 flex flex-col gap-1">
                    <span class="text-xs md:text-base font-bold text-[var(--text-primary)] group-hover:text-[var(--primary)] transition-colors duration-300 leading-snug">
                      {related.title}
                    </span>
                    <span class="hidden sm:block text-xs text-[var(--text-secondary)] font-light line-clamp-2">
                      {related.description}
                    </span>
                  </div>
                </a>
              ))
          }
        </div>
      </section>

      <!-- ═══════════════════════════════════════════════
           CTA BANNER
      ════════════════════════════════════════════════ -->
      <section
        class="w-full p-[2px] rounded-2xl md:rounded-3xl bg-gradient-to-r from-purple-500 via-indigo-500 to-blue-500 shadow-2xl relative overflow-hidden group">
        <div
          class="p-6 md:p-12 rounded-[14px] md:rounded-[22px] bg-[#0c051a] flex flex-col md:flex-row justify-between items-center gap-6 md:gap-8 relative z-10 text-center md:text-left">
          <div class="flex flex-col gap-2">
            <h2
              class="text-xl md:text-4xl font-extralight tracking-tight text-white">
              {service.ctaHeading || `Ready to get started with our`}
              {
                !service.ctaHeading && (
                  <span class="text-purple-400 font-normal">
                    {" "}
                    {service.title}?
                  </span>
                )
              }
            </h2>
            <p class="text-xs md:text-sm text-purple-200/70 font-light">
              Let's build something that moves your business forward.
            </p>
          </div>
          <a href="/#contact" class="shrink-0 w-full md:w-auto">
            <MagneticButton
              client:load
              className="w-full md:w-auto px-6 md:px-8 py-3 md:py-3.5 border border-purple-500 bg-purple-500/10 hover:bg-purple-500 text-white font-bold text-xs tracking-wider uppercase">
              {service.ctaLabel || "Let's Discuss"}
            </MagneticButton>
          </a>
        </div>
      </section>
    </main>

    <Contact client:load />
    <Footer />
  </div>
</Layout>
