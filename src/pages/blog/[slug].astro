---
import Layout from '../../layouts/Layout.astro';
import { SmoothScroll } from '../../components/SmoothScroll';
import { CustomCursor } from '../../components/CustomCursor';
import { Navbar } from '../../components/Navbar';
import { Footer } from '../../components/Footer';
import { allBlogPosts } from '../../data/blogs';

export async function getStaticPaths() {
  return allBlogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;

const sortedPosts = [...allBlogPosts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);
const currentIndex = sortedPosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : null;
const nextPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : null;

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric'
  });
}

function parseMarkdown(text: string) {
  let html = text.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g, 
    '<a href="$2" class="text-[var(--primary)] font-semibold hover:underline relative interactive">$1</a>'
  );
  html = html.replace(
    /\*\*([^*]+)\*\*/g, 
    '<strong class="font-extrabold text-[var(--text-primary)]">$1</strong>'
  );
  return html;
}
---

<Layout title={`${post.title} | Words4Web Blog`}>
  <SmoothScroll client:load />
  <CustomCursor client:load />

  <div class="relative w-full min-h-screen selection:bg-[var(--primary)] selection:text-white">
    <Navbar client:load />

    <main class="pt-32 pb-24">
      
      <div class="px-6 md:px-12 mb-8">
        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-semibold text-[var(--text-secondary)] hover:text-[var(--primary)] transition-colors duration-300 interactive">
          <svg 
            xmlns="http://www.w3.org/2000/svg" 
            class="w-4 h-4" 
            fill="none" 
            viewBox="0 0 24 24" 
            stroke="currentColor" 
            stroke-width="2.5"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          <span>Back to Blogs</span>
        </a>
      </div>

      <div class="w-full max-w-[1200px] [@media(min-width:1400px)]:max-w-[80vw] mx-auto rounded-3xl overflow-hidden shadow-2xl mb-12 border border-black/5 dark:border-white/5 animate-pulse-glow">
        <div class="relative w-full" style="padding-top: 56.25%;">
          <img 
            src={post.headerImage} 
            alt={post.title} 
            class="absolute inset-0 w-full h-full object-cover"
          />
        </div>
      </div>

      <article class="max-w-4xl mx-auto px-6 md:px-12">
        <div class="space-y-6 mb-12">
          <div class="flex items-center gap-3 text-xs md:text-sm font-semibold text-[var(--text-secondary)] uppercase tracking-wider">
            <span>{formatDate(post.date)}</span>
            <span class="w-1.5 h-1.5 rounded-full bg-[var(--primary)]"></span>
            <span>By {post.author}</span>
          </div>
          <h1 class="font-display text-3xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-[var(--text-primary)] leading-tight">
            {post.title}
          </h1>
        </div>

      <div class="space-y-8 text-base md:text-lg leading-relaxed text-[var(--text-secondary)] font-light">
        {post.content.map((block) => {
          if (block.type === 'heading') {
            return (
              <h2 class="font-display text-2xl md:text-3xl font-extrabold text-[var(--text-primary)] tracking-tight pt-6 pb-2 border-b border-black/5 dark:border-white/5">
                {block.value}
              </h2>
            );
          } else if (block.type === 'image') {
            return (
              <div class="relative p-[2px] rounded-2xl overflow-hidden my-8 w-full group">
                <div class="absolute inset-0 rounded-2xl overflow-hidden pointer-events-none">
                  <div
                    class="absolute top-1/2 left-1/2 w-[300%] h-[300%] animate-border-trace"
                    style="background: conic-gradient(from 0deg, transparent 0deg, transparent 320deg, #a855f7 340deg, #c084fc 350deg, #e9d5ff 360deg);"
                  />
                </div>
                <div class="relative rounded-[14px] overflow-hidden bg-black/5 dark:bg-white/5 z-10">
                  <img 
                    src={block.value} 
                    alt="Blog visual asset" 
                    class="w-full h-auto object-cover max-h-[600px]"
                  />
                </div>
              </div>
            );
          } else {
            return (
              <p 
                class="whitespace-pre-line " 
                set:html={parseMarkdown(block.value)} 
              />
            );
          }
        })}
      </div>

      {post.faqs && post.faqs.length > 0 && (
        <div class="mt-16 pt-12 border-t border-black/10 dark:border-white/10">
          <h3 class="font-display text-2xl md:text-3xl font-bold text-[var(--text-primary)] mb-8">
            Frequently Asked Questions
          </h3>
          <div class="space-y-4">
            {post.faqs.map((faq) => (
              <details class="group bg-[var(--background-secondary)] border border-black/5 dark:border-white/5 rounded-2xl p-6 transition-all duration-300 open:shadow-lg">
                <summary class="flex items-center justify-between font-display text-base md:text-lg font-bold text-[var(--text-primary)] cursor-pointer list-none select-none interactive">
                  <span>{faq.question}</span>
                  <span class="transition-transform duration-300 group-open:rotate-180 text-[var(--primary)] font-bold text-lg shrink-0 ml-4">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                  </span>
                </summary>
                <div class="mt-4 text-sm md:text-base text-[var(--text-secondary)] font-light leading-relaxed pt-2 border-t border-black/5 dark:border-white/5">
                  <p set:html={parseMarkdown(faq.answer)} />
                </div>
              </details>
            ))}
          </div>
        </div>
      )}

      {post.citations && post.citations.length > 0 && (
        <div class="mt-16 pt-12 border-t border-black/10 dark:border-white/10">
          <h3 class="font-display text-xl md:text-2xl font-bold text-[var(--text-primary)] mb-6 flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5 text-[var(--primary)]">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25" />
            </svg>
            <span>Research & Citations</span>
          </h3>
          <ul class="space-y-3">
            {post.citations.map((cite) => (
              <li class="flex items-start gap-3 text-sm text-[var(--text-secondary)]">
                <span class="text-[var(--primary)] font-bold mt-0.5">•</span>
                <a href={cite} target="_blank" rel="noopener noreferrer" class="hover:text-[var(--primary)] hover:underline break-all transition-colors duration-200 interactive font-medium">
                  {cite}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}

      {(prevPost || nextPost) && (
        <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevPost ? (
            <a href={`/blog/${prevPost.slug}`} class="group relative p-[2px] rounded-2xl overflow-hidden block">
              <div class="absolute inset-0 rounded-2xl overflow-hidden pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                <div class="absolute top-1/2 left-1/2 w-[300%] h-[300%] animate-border-trace" style="background: conic-gradient(from 0deg, transparent 0deg, transparent 320deg, #a855f7 340deg, #c084fc 350deg, #e9d5ff 360deg);" />
              </div>
              <div class="relative flex flex-col gap-2 p-5 bg-white dark:bg-[#0c0a12] border border-black/5 dark:border-white/5 rounded-[14px] z-10 h-full">
                <span class="flex items-center gap-1.5 text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" /></svg>
                  Previous
                </span>
                <p class="text-sm font-bold text-[var(--text-primary)] group-hover:text-[var(--primary)] transition-colors duration-300 leading-snug line-clamp-2">{prevPost.title}</p>
              </div>
            </a>
          ) : <div />}

          {nextPost ? (
            <a href={`/blog/${nextPost.slug}`} class="group relative p-[2px] rounded-2xl overflow-hidden block sm:text-right">
              <div class="absolute inset-0 rounded-2xl overflow-hidden pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                <div class="absolute top-1/2 left-1/2 w-[300%] h-[300%] animate-border-trace" style="background: conic-gradient(from 0deg, transparent 0deg, transparent 320deg, #a855f7 340deg, #c084fc 350deg, #e9d5ff 360deg);" />
              </div>
              <div class="relative flex flex-col gap-2 p-5 bg-white dark:bg-[#0c0a12] border border-black/5 dark:border-white/5 rounded-[14px] z-10 h-full sm:items-end">
                <span class="flex items-center gap-1.5 text-xs font-bold text-[var(--text-secondary)] uppercase tracking-wider">
                  Next
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
                </span>
                <p class="text-sm font-bold text-[var(--text-primary)] group-hover:text-[var(--primary)] transition-colors duration-300 leading-snug line-clamp-2">{nextPost.title}</p>
              </div>
            </a>
          ) : <div />}
        </div>
      )}

      <div class="relative p-[2px] rounded-3xl overflow-hidden mt-16 group">
        <div class="absolute inset-0 rounded-3xl overflow-hidden pointer-events-none">
          <div
            class="absolute top-1/2 left-1/2 w-[300%] h-[300%] animate-border-trace"
            style="background: conic-gradient(from 0deg, transparent 0deg, transparent 320deg, #a855f7 340deg, #c084fc 350deg, #e9d5ff 360deg);"
          />
        </div>
        <div class="relative p-8 md:p-12 bg-white dark:bg-[#0c0a12] border border-black/5 dark:border-white/5 rounded-[22px] text-center space-y-6 z-10">
          <h3 class="font-display text-2xl md:text-3xl font-extrabold text-[var(--text-primary)]">
            Command Your Brand's Growth
          </h3>
          <p class="max-w-xl mx-auto text-sm md:text-base text-[var(--text-secondary)] font-light leading-relaxed">
            Ready to design a custom digital marketing strategy that drives real business results? Connect with our experts today.
          </p>
          <div>
            <a href="/#contact" class="inline-flex items-center justify-center bg-[var(--primary)] text-white font-bold py-3 px-8 rounded-full hover:bg-[var(--primary)]/90 hover:scale-105 transition-all duration-300 shadow-md hover:shadow-lg interactive">
              Schedule a Strategy Call
            </a>
          </div>
        </div>
      </div>

    </article>
    </main>

    <Footer />
  </div>
</Layout>
