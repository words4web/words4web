---
import Layout from '../../layouts/Layout.astro';
import { SmoothScroll } from '../../components/SmoothScroll';
import { CustomCursor } from '../../components/CustomCursor';
import { Navbar } from '../../components/Navbar';
import { Footer } from '../../components/Footer';
import { allBlogPosts } from '../../data/blogs';

const sortedPosts = [...allBlogPosts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()
);

function formatDate(dateStr: string) {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric'
  });
}
---

<Layout title="Blog | Words4Web Digital Marketing Insights">
  <SmoothScroll client:load />
  <CustomCursor client:load />
  
  <div class="relative w-full min-h-screen selection:bg-[var(--primary)] selection:text-white">
    <Navbar client:load />
    
    <main class="pt-32 pb-24 px-6 md:px-12 max-w-7xl mx-auto">
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-6">
        <div class="inline-flex items-center gap-2 bg-[var(--primary)]/10 dark:bg-[var(--primary)]/15 border border-[var(--primary)]/20 text-[var(--primary)] px-4 py-1.5 rounded-full text-xs font-bold tracking-wide uppercase select-none shadow-sm">
          <span>Insights & Guides</span>
        </div>
        <h1 class="font-display text-4xl md:text-6xl font-extrabold tracking-tight text-[var(--text-primary)]">
          The <span class="bg-gradient-to-r from-[var(--primary)] to-[#9d4edd] bg-clip-text text-transparent">Words4Web</span> Blog
        </h1>
        <p class="text-lg md:text-xl text-[var(--text-secondary)] font-light leading-relaxed">
          Expert strategy, industry insights, and step-by-step guides to help your brand command visibility and grow online in 2026.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {sortedPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="relative block group h-full">
            <div class="relative p-[2px] rounded-3xl overflow-hidden h-full transition-transform duration-500 group-hover:-translate-y-2 group-hover:shadow-[0_20px_40px_rgba(168,85,247,0.15)]">
              
              <div class="absolute inset-0 rounded-3xl overflow-hidden pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                <div
                  class="absolute top-1/2 left-1/2 w-[300%] h-[300%] animate-border-trace"
                  style="background: conic-gradient(from 0deg, transparent 0deg, transparent 320deg, #a855f7 340deg, #c084fc 350deg, #e9d5ff 360deg);"
                />
              </div>
              
              <div class="relative flex flex-col justify-between h-full bg-white dark:bg-[#0c0a12] border border-black/5 dark:border-white/5 rounded-[22px] overflow-hidden z-10">
                
                <div>
                  <div class="relative aspect-video w-full overflow-hidden bg-black/5 dark:bg-white/5">
                    <img 
                      src={post.headerImage} 
                      alt={post.title}
                      class="object-cover w-full h-full transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity" />
                  </div>

                  <div class="p-6 space-y-4">
                    <div class="flex items-center gap-4 text-xs font-semibold text-[var(--text-secondary)] uppercase tracking-wider">
                      <span>{formatDate(post.date)}</span>
                      <span class="w-1 h-1 rounded-full bg-[var(--primary)]" />
                      <span>{post.author}</span>
                    </div>

                    <h3 class="font-display text-xl md:text-2xl font-bold text-[var(--text-primary)] leading-snug group-hover:text-[var(--primary)] transition-colors duration-300">
                      {post.title}
                    </h3>
                  </div>
                </div>

                <div class="p-6 pt-0 mt-auto">
                  <div class="flex items-center gap-2 text-sm font-bold text-[var(--primary)] group/link">
                    <span>Read Article</span>
                    <svg 
                      xmlns="http://www.w3.org/2000/svg" 
                      class="w-4 h-4 transition-transform duration-300 group-hover/link:translate-x-1" 
                      fill="none" 
                      viewBox="0 0 24 24" 
                      stroke="currentColor" 
                      stroke-width="2.5"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </div>
                </div>

              </div>
            </div>
          </a>
        ))}
      </div>
    </main>

    <Footer />
  </div>
</Layout>
